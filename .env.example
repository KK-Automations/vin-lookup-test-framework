# Copy to .env and fill in real values. Never commit .env.
# All provider keys are optional: providers without keys are skipped at startup.

# CarAPI (https://carapi.app) free tier
CARAPI_API_TOKEN=
CARAPI_API_SECRET=

# Auto.dev (https://auto.dev) free tier
AUTODEV_API_KEY=

# SQLite cache location
VIN_DB_PATH=data/vin_cache.sqlite3
